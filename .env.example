# kuebiko の動作設定例です。コピーして .env として使用してください。
#   cp .env.example .env

# アクセスを許可する IP 範囲（カンマ区切り）。未設定ですべて許可。
APP_ALLOWED_IPS=192.168.0.0/24

# 1 を設定すると自己署名証明書を自動生成し HTTPS で起動する。
# 実証明書を使う場合は APP_TLS_CERT / APP_TLS_KEY でパスを指定する。
APP_TLS_AUTO=1

# 生存確認切れの監視間隔
APP_CHECK_INTERVAL=1h

# 閲覧専用ページのメール掲載用公開 URL（HTTPS 運用時は https で指定）
# 例: https://192.168.0.10:8080
#APP_PUBLIC_URL=
